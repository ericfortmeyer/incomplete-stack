#!/bin/sh

set -e

PREREQ="00-opensc-pksc11-luks"
prereqs() {
	echo "$PREREQ"
}
case "$1" in
	prereqs)
		prereqs
		exit 0
		;;
esac

. /lib/cryptsetup/functions

luks_unlock() {
	case "$CRYPTTAB_OPTIONS" in
		*luks*)
			/usr/sbin/cryptsetup --token-only open "$CRYPTTAB_SOURCE" "$CRYPTTAB_NAME" --tries 10
		  	;;
                *)
		    return 0
		    ;;
	esac
}

crypttab_foreach_entry luks_unlock
